# Copy this file to .env and fill in real values before running the app.
# Never commit the real .env file.

# PostgreSQL connection used by Prisma. In Docker Compose this points at the
# "db" service; for local (non-Docker) development point it at localhost.
DATABASE_URL="postgresql://school:school@localhost:5432/school_attendance?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER="school"
POSTGRES_PASSWORD="school"
POSTGRES_DB="school_attendance"
